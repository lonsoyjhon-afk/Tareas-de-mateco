void dibujarAhorcado(int intentos, int intentostotales){
    int errores_reales = intentostotales - intentos;
    int errores = (errores_reales*6)/intentostotales;
    if (errores>6) errores=6;
    cout << " +---+" <<endl;
    cout << " |   |" <<endl;
    cout << " |   |" <<endl;
    switch (errores){
        case 0:
        cout<< "    |"<<endl;
        cout<< "    |"<<endl;
        cout<< "    |"<<endl;
        break;
        case 1:
        cout<< " O  |"<<endl;
        cout<< "    |"<<endl;
        cout<< "    |"<<endl;
        break;
        case 2:
        cout<< " O  |"<<endl;
        cout<< " |  |"<<endl;
        cout<< "    |"<<endl;
        break;
        case 3:
        cout<< " O  |"<<endl;
        cout<< "/|  |"<<endl;
        cout<< "    |"<<endl;
        break;
        case 4:
        cout<< " O  |"<<endl;
        cout<< "/|\\ |"<<endl;
        cout<< "    |"<<endl;
        break;
        case 5:
        cout<< " O  |"<<endl;
        cout<< "/|\\ |"<<endl;
        cout<< "/   |"<<endl;
        break;
        case 6://como vas a perder xddddddd//
        cout<< " O  |"<<endl;
        cout<< "/|\\ |"<<endl;
        cout<< "/ \\ |"<<endl;
        break;
    }
    cout<<"================"<< endl;
}
